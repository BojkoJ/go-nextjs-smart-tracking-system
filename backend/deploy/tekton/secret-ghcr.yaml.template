apiVersion: v1
kind: Secret
metadata:
  name: ghcr-credentials
  namespace: tracking-system
  annotations:
    # Tekton cred-init rozpozná tento annotation a nakonfiguruje
    # /kaniko/.docker/config.json pro Kaniko image push
    tekton.dev/docker-0: https://ghcr.io
type: kubernetes.io/dockerconfigjson
data:
  # Hodnota = base64({"auths":{"ghcr.io":{"username":"<github-username>","password":"<PAT>","auth":"<base64(user:PAT)>"}}})
  # Jak vygenerovat:
  #   docker login ghcr.io -u <github-username> -p <PAT>
  #   cat ~/.docker/config.json | base64 -w 0
  .dockerconfigjson: <BASE64_DOCKER_CONFIG_JSON>